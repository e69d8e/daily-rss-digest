{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Daily RSS Digest 核心业务时序图",
    "locale": "zh-CN",
    "quality_profile": "showcase",
    "column_fit": "spread",
    "viewBox": [1000, 780],
    "views": [
      {
        "id": "fetch-and-ingest",
        "label": "1. 触发与多源抓取",
        "focus": ["user", "api", "engine", "db", "rss"],
        "note": "从 Cron 或手动触发开始，读取频道规则并并发抓取外部 RSS 资讯与正文"
      },
      {
        "id": "ai-clustering",
        "label": "2. 过滤与 AI 议题提炼",
        "focus": ["engine", "db", "ai"],
        "note": "关键词黑白名单过滤后，提交候选集给 AI 提炼跨源议题与生成播音文稿"
      },
      {
        "id": "store-and-notify",
        "label": "3. 存储归档与全渠道派发",
        "focus": ["engine", "db", "push", "api", "user"],
        "note": "Upsert 存入 SQLite，并发投递至飞书、企微、Telegram、Discord 及邮件"
      }
    ]
  },
  "participants": [
    {
      "id": "user",
      "type": "external",
      "label": "用户 / 定时",
      "sublabel": "触发晨报"
    },
    {
      "id": "api",
      "type": "frontend",
      "label": "Next.js",
      "sublabel": "/api/digests",
      "brand": "next-js"
    },
    {
      "id": "engine",
      "type": "backend",
      "label": "生成引擎",
      "sublabel": "核心调度"
    },
    {
      "id": "rss",
      "type": "external",
      "label": "外部 RSS",
      "sublabel": "Feed / HTML"
    },
    {
      "id": "db",
      "type": "database",
      "label": "SQLite",
      "sublabel": "Prisma ORM",
      "brand": "sqlite"
    },
    {
      "id": "ai",
      "type": "backend",
      "label": "AI 引擎",
      "sublabel": "OpenAI 协议",
      "brand": "openai"
    },
    {
      "id": "push",
      "type": "messagebus",
      "label": "消息派发",
      "sublabel": "Webhook/SMTP"
    }
  ],
  "segments": [
    {
      "from": 155,
      "to": 350,
      "label": "1. 触发与数据采集"
    },
    {
      "from": 360,
      "to": 510,
