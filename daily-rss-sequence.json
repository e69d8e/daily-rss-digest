    }
  ],
  "messages": [
    {
      "id": "trigger-digest",
      "from": "user",
      "to": "api",
      "y": 175,
      "label": "触发今日晨报 (Cron / 手动)",
      "variant": "emphasis"
    },
    {
      "id": "invoke-generator",
      "from": "api",
      "to": "engine",
      "y": 215,
      "label": "调用 generateDailyDigest()",
      "variant": "default"
    },
    {
      "id": "query-feeds",
      "from": "engine",
      "to": "db",
      "y": 255,
      "label": "查询启用源与过滤规则",
      "variant": "default"
    },
    {
      "id": "return-feeds",
      "from": "db",
      "to": "engine",
      "y": 295,
      "label": "返回订阅源列表",
      "variant": "return"
    },
    {
      "id": "fetch-feed-xml",
      "from": "engine",
      "to": "rss",
      "y": 335,
      "label": "抓取 Feed XML & 正文 HTML",
      "variant": "emphasis"
    },
    {
      "id": "return-articles",
      "from": "rss",
      "to": "engine",
      "y": 375,
      "label": "返回清洗后文章列表",
      "variant": "return"
    },
    {
      "id": "persist-filtered",
      "from": "engine",
      "to": "db",
      "y": 415,
      "label": "留存文章并执行关键词过滤",
      "variant": "dashed"
    },
    {
      "id": "request-ai-clustering",
      "from": "engine",
      "to": "ai",
      "y": 455,
      "label": "提交候选集请求聚类与摘要",
      "variant": "emphasis"
    },
    {
      "id": "return-ai-insights",
      "from": "ai",
      "to": "engine",
      "y": 495,
      "label": "返回议题聚类、评分与 TTS 文稿",
      "variant": "return"
    },
    {
      "id": "upsert-digest",
      "from": "engine",
      "to": "db",
      "y": 535,
      "label": "Upsert 存储当日 DailyDigest",
      "variant": "default"
    },
    {
      "id": "dispatch-notifications",
      "from": "engine",
      "to": "push",
      "y": 575,
      "label": "派发飞书/企微/TG/Discord/邮件",
      "variant": "emphasis"
    },
    {
      "id": "log-delivery",
      "from": "push",
      "to": "engine",
      "y": 615,
      "label": "写入 DeliveryLog 日志",
      "variant": "return"
    },
    {
      "id": "return-completed-digest",
      "from": "engine",
      "to": "api",
      "y": 655,
      "label": "返回最新排版完整晨报",
      "variant": "return"
    },
    {
      "id": "render-view",
      "from": "api",
      "to": "user",
      "y": 695,
      "label": "报刊视图渲染 & TTS 就绪",
      "variant": "return"
    }
  ],
