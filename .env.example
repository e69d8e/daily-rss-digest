# ==========================================
# Daily RSS Digest · 环境变量模板 (.env.example)
# ==========================================

# 1. 本地数据库 (开发环境默认使用本地 SQLite)
DATABASE_URL="file:./dev.db"

# 2. Turso 云端 LibSQL 数据库 (生产环境 / Netlify 部署必填)
# 注册并在 https://turso.tech 创建免费数据库获取
TURSO_DATABASE_URL="libsql://your-database-name.turso.io"
TURSO_AUTH_TOKEN="your_turso_auth_token_here"

# 3. 管理访问安全密码 (【重要】部署公网时强烈建议配置)
# 设置后访问 /settings 设置中心需要输入该密码，防止任意访客篡改或查看配置
ADMIN_PASSWORD="your_admin_secret_password"

# 4. 云端安全 AI 密钥注入 (【重要】公网防泄露最佳实践)
# 若在云端平台直接配置 AI_API_KEY，密钥将留存在服务端，公网前端绝对不会暴露明文
AI_API_KEY="sk-your-ai-api-key"

# 5. 定时任务触发接口鉴权密钥 (用于保护 /api/cron/digest)
CRON_SECRET="your_random_secure_cron_secret"

# 6. 可选系统全局 AI 默认配置 (亦可在设置中心界面配置)
# AI_PROVIDER="deepseek"
# AI_API_FORMAT="chat_completions" # 可选: chat_completions | response | messages
# AI_BASE_URL="https://api.deepseek.com/v1"
# AI_MODEL="deepseek-chat"
